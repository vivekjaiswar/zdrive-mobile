{
  "expo": {
    "name": "OJI Drive",
    "slug": "zdrive_mobile",
    "version": "1.9.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zdrive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.zhdrive.app",
      "buildNumber": "14",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "in.zhdrive.app",
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#140A05",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#140A05",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#140A05",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OJI Drive to access your photos so you can upload them to your cloud."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OJI Drive to read your photos so it can back them up to your cloud.",
          "savePhotosPermission": "Allow OJI Drive to save photos to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow OJI Drive to use Face ID to unlock the app."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "zennialhub",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "./plugins/withGradleWrapperFix.js",
      "./plugins/withGradleJavaHomeFix.js",
      "./plugins/withGradleMemoryFix.js",
      "expo-audio",
      "expo-image",
      "expo-web-browser",
      "@sentry/react-native",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ed86bb4-131b-42cf-b8e1-0c331c6333d0"
      }
    },
    "owner": "vivekjaiswar"
  }
}

{
  "expo": {
    "name": "ZDrive",
    "slug": "zdrive_mobile",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zdrivemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.zhdrive.app",
      "buildNumber": "8",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.zhdrive.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-document-picker",
      "@react-native-google-signin/google-signin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ZDrive to use Face ID to unlock the app."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "zennialhub",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "./plugins/withGradleWrapperFix.js",
      "./plugins/withGradleJavaHomeFix.js",
      "./plugins/withGradleMemoryFix.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ed86bb4-131b-42cf-b8e1-0c331c6333d0"
      }
    },
    "owner": "vivekjaiswar"
  }
}

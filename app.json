{
  "expo": {
    "name": "ZDrive",
    "slug": "zdrive_mobile",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zdrivemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.zhdrive.app",
      "buildNumber": "3",
      "supportsTablet": true
    },
    "android": {
      "package": "in.zhdrive.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ZDrive to use Face ID to unlock the app."
        }
      ],
      "@sentry/react-native/expo",
      "./plugins/withGradleWrapperFix.js",
      "./plugins/withGradleJavaHomeFix.js",
      "./plugins/withGradleMemoryFix.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ed86bb4-131b-42cf-b8e1-0c331c6333d0"
      }
    }
  }
}
